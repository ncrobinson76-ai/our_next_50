DATABASE_URL=
PORT=3000

# Replit Auth (OpenID Connect). Set automatically in a Repl; for local dev
# outside Replit, set these to match your Repl's values.
REPL_ID=
REPLIT_DOMAINS=
ISSUER_URL=https://replit.com/oidc

# Long random string used to sign session cookies.
SESSION_SECRET=

# Used by the Package 5 extraction pipeline (src/inbox/extraction.ts).
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
