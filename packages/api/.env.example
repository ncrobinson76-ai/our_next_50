DATABASE_URL=
PORT=3000

# Replit Auth (OpenID Connect). Set automatically in a Repl; for local dev
# outside Replit, set these to match your Repl's values.
REPL_ID=
REPLIT_DOMAINS=
ISSUER_URL=https://replit.com/oidc

# Long random string used to sign session cookies.
SESSION_SECRET=

# Used by the Package 5 extraction pipeline (src/inbox/extraction.ts).
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Used by the Package 6 voice channel's transcription step
# (src/voice/transcription.ts). Not needed outside Replit / in tests —
# NODE_ENV=test uses a stubbed transcription path instead (see README.md).
DEEPGRAM_API_KEY=

# Object storage for uploaded audio (src/voice/storage.ts). Only needed
# outside Replit; inside a Repl, @replit/object-storage auto-detects the
# bucket bound to the Repl and no config is required here. NODE_ENV=test
# uses a local filesystem stub instead.
